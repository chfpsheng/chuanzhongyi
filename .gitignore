# 站点配置：含数据库地址、库名、密码明文，以及米拓安全码
# 本仓库为公开仓库，绝不能纳入版本库。
# 2026-09-21 已用 `git rm -r --cached config/` 从跟踪中移除（本地文件保留，不影响运行）。
# 部署到服务器请用 FTP 上传代码，config/ 由服务器本地保留，不要覆盖。
/config/

# 运行时缓存（栏目/配置/模板编译缓存）
/cache/
/templates/*/cache/

# 自动生成的缩略图
/upload/thumb_src/

# 编辑器本地数据
/.codebuddy/

# 数据库备份：含全库结构与数据，本仓库为公开仓库，不纳入版本库
/admin/databack/*.sql
/admin/databack/*.db
/_backup/

# 临时/备份文件
*.bak
*.zip

# 上传的资源文件（头像/横幅/缩略图等部署产物，体积大，由服务器 FTP 维护，不入版本库）
/upload/

# 设计素材（横幅等二进制图片，同上，不入版本库）
/_assets/

# 数据库管理模块及其全量备份（含全库数据，公开仓库禁止入库）
/zyadmin/

# 工具脚本与脚本产物（含批量下载的原图、临时备份、本地接口配置等）
/tools/

# 临时探针/测试文件
zzz*
zzz.*

# 采集的原始数据（体积大，非源码）
采集数据/

# 散落的横幅图片（二进制，同 upload/ 处理）
/banner/

# 占位/素材图片（二进制）
/public/images/

# 分析产物（关键词表、覆盖率报告等 Excel）
*.xlsx

# 临时探针/测试残留文件
query
zzz*
